[Desktop Entry]
Version=1.11.0
Name=Gnome AI Chat
GenericName=AI Chat
Comment=Chat with local AI models via Ollama
Exec=io.github.pebois.gnome-ai-chat %U
Icon=io.github.pebois.gnome-ai-chat
Terminal=false
Type=Application
Categories=Network;InstantMessaging;
Keywords=ollama;ai;chat;llm;assistant;
StartupWMClass=io.github.pebois.gnome-ai-chat
DBusActivatable=true
X-GNOME-UsesNotifications=false
Actions=new-conversation;

[Desktop Action new-conversation]
Name=New Conversation
Exec=io.github.pebois.gnome-ai-chat --new-conversation
