{
  "name": "io.github.pebois.gnome-ai-chat",
  "version": "1.3.1",
  "description": "A simple chat application for GNOME built with JavaScript (GJS), Gtk4, and Libadwaita. It communicates with the Ollama HTTP API.",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "build-watch": "tsdown --watch",
    "start": "gjs -m dist/main.mjs",
    "test": "node --no-warnings --experimental-vm-modules node_modules/.bin/jest --verbose",
    "compile-resources": "glib-compile-resources --target=dist/resources.gresource resources.gresource.xml",
    "flatpak-run": "flatpak run io.github.pebois.gnome-ai-chat",
    "flatpak-build": "flatpak-builder --force-clean --user --install-deps-from=flathub --repo=.flatpak-repo --install .flatpak-builddir io.github.pebois.gnome-ai-chat.json",
    "flatpak-cache": "mkdir -p /tmp/npm-flatpak-cache && cp package.json package-lock.json /tmp/npm-flatpak-cache/ && npm install --prefix /tmp/npm-flatpak-cache --cache /tmp/npm-flatpak-cache/cache && tar czf .npm-cache.tar.gz -C /tmp/npm-flatpak-cache --transform 's/cache/npm-cache/' cache && rm -rf /tmp/npm-flatpak-cache",
    "lint": "eslint . --cache",
    "lint-fix": "eslint . --cache --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@girs/adw-1": "^1.10.0-4.0.0-beta.42",
    "@girs/gdk-4.0": "^4.0.0-4.0.0-beta.42",
    "@girs/gdkpixbuf-2.0": "^2.0.0-4.0.0-beta.42",
    "@girs/gio-2.0": "^2.88.0-4.0.0-beta.42",
    "@girs/giounix-2.0": "^2.0.0-4.0.0-beta.42",
    "@girs/gjs": "^4.0.0-beta.42",
    "@girs/glib-2.0": "^2.88.0-4.0.0-beta.42",
    "@girs/gobject-2.0": "^2.88.0-4.0.0-beta.42",
    "@girs/graphene-1.0": "^1.0.0-4.0.0-beta.42",
    "@girs/gtk-4.0": "^4.22.1-4.0.0-beta.42",
    "@girs/gtksource-5": "^5.20.0-4.0.0-beta.42",
    "@girs/pango-1.0": "^1.57.0-4.0.0-beta.42",
    "@girs/soup-3.0": "^3.6.6-4.0.0-beta.42",
    "@girs/webkit-6.0": "^2.51.93-4.0.0-beta.42",
    "@stylistic/eslint-plugin": "^5.9.0",
    "@types/jest": "^30.0.0",
    "eslint": "^10.0.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "tsdown": "^0.21.0-beta.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "author": "Pierre-Emmanuel Bois"
}
